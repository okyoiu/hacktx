# Copy to .env and fill in. Never commit .env.

# Meta Model API key (Muse Spark + Muse Voice Transcribe), from dev.meta.ai
MODEL_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3

# serpapi.com/manage-api-key
SERPAPI_KEY=
# Where place searches are centred (Google Maps "ll" format). Default: downtown Austin.
DEMO_LL=@30.2672,-97.7431,13z

# Tiger Data (Postgres + pgvector) connection string.
# Local fallback: docker run -d --name hello-again-db -p 127.0.0.1:5432:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg17
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Where capture/ and the overlay find the memory service
MEMORY_URL=http://localhost:8000
# Link the "new face" card copies for guests. Use the laptop's LAN IP so phones on the same Wi-Fi can open it.
ENROLL_URL=http://localhost:8000/enroll
